# === Supabase ===
# Βρες τα στο Supabase Dashboard -> Project Settings -> API
# Αντίγραψε αυτό το αρχείο σε .env.local και συμπλήρωσε τιμές.
# ΤΟ .env.local ΔΕΝ ανεβαίνει στο git.

# Public (ασφαλή να εκτεθούν στον client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (ΠΟΤΕ στον client — μόνο σε server actions / API routes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
